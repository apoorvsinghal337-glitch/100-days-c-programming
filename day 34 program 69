#include <stdio.h>

int main() {
    int arr[100], n, i;
    int largest, secondLargest;
    int found = 0;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    largest = arr[0];

    for (i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }

    for (i = 0; i < n; i++) {
        if (arr[i] < largest) {
            if (found == 0 || arr[i] > secondLargest) {
                secondLargest = arr[i];
                found = 1;
            }
        }
    }

    if (found == 1) {
        printf("%d", secondLargest);
    } else {
        printf("-1");
    }

    return 0;
}
