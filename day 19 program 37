
#include <stdio.h>

int main() {
    int a, b, i;

    scanf("%d %d", &a, &b);

    if (a == 0 || b == 0) {
        printf("0");
        return 0;
    }

    if (a < 0) a = -a;
    if (b < 0) b = -b;

    i = (a > b) ? a : b;

    while (1) {
        if (i % a == 0 && i % b == 0) {
            printf("%d", i);
            break;
        }
        i++;
    }

    return 0;
}
