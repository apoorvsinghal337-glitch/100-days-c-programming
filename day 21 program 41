
#include <stdio.h>

int main() {
    int n, temp, first, last;
    int pow = 1, middle, result;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;
    last = n % 10;

    while (temp >= 10) {
        temp = temp / 10;
        pow = pow * 10;
    }

    first = temp;

    if (n < 10) {
        result = n;
    } else {
        middle = (n % pow) / 10;
        result = last * pow + middle * 10 + first;
    }

    printf("Number after swapping = %d", result);

    return 0;
}
