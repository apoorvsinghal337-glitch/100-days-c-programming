
#include <stdio.h>

int main() {
    long long n, rem, result = 0, place = 1;

    scanf("%lld", &n);

    if (n == 0) {
        printf("1");
        return 0;
    }

    while (n > 0) {
        rem = n % 10;

        if (rem != 0 && rem != 1) {
            printf("Invalid binary number");
            return 0;
        }

        result = result + (1 - rem) * place;
        place = place * 10;
        n = n / 10;
    }

    printf("%lld", result);

    return 0;
}
