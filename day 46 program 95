
#include <stdio.h>

int main() {
    char str[100];
    int i, length = 0, flag = 0;

    printf("Enter a string: ");
    scanf("%99s", str);

    while (str[length] != '\0') {
        length++;
    }

    for (i = 0; i < length / 2; i++) {
        if (str[i] != str[length - 1 - i]) {
            flag = 1;
            break;
        }
    }

    if (flag == 0) {
        printf("Palindrome String");
    } else {
        printf("Not a Palindrome String");
    }

    return 0;
}
