
#include <stdio.h>

int main() {
    int a, b;
    char op;

    printf("Enter expression (e.g. 10 + 5): ");
    scanf("%d %c %d", &a, &op, &b);

    switch (op) {
        case '+':
            printf("Result = %d", a + b);
            break;

        case '-':
            printf("Result = %d", a - b);
            break;

        case '*':
            printf("Result = %d", a * b);
            break;

        case '/':
            if (b != 0)
                printf("Result = %.2f", (float)a / b);
            else
                printf("Division by zero not allowed");
            break;

        case '%':
            if (b != 0)
                printf("Result = %d", a % b);
            else
                printf("Modulo by zero not allowed");
            break;

        default:
            printf("Invalid operator");
    }

    return 0;
}
